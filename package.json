{
  "name": "shakthi",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "dev:nari": "pnpm --filter \"./apps/nari\" dev",
    "dev:marketplace": "pnpm --filter \"./apps/marketplace\" dev",
    "dev:admin": "pnpm --filter \"./apps/admin\" dev",
    "dev:apps": "turbo run dev --filter=./apps/*",
    "build": "turbo run build",
    "build:apps": "turbo run build --filter=./apps/*",
    "build:mobile": "turbo run mobile:build",
    "build:rust": "turbo run rust:build",
    "codegen": "turbo run proto:generate",
    "proto:generate": "cd packages/protocols && buf generate",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.0"
  }
}
