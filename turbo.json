{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "proto:generate": {
      "inputs": [
        "packages/protocols/proto/**/*.proto",
        "packages/protocols/buf.gen.yaml"
      ],
      "outputs": [
        "packages/protocols/generated-ts/**",
        "packages/protocols/generated-dart/**",
        "packages/protocols/generated-rust/**"
      ]
    },
    "build": {
      "dependsOn": [
        "^proto:generate",
        "^build"
      ],
      "inputs": [
        "src/**/*.{ts,tsx,css}",
        "next.config.ts",
        "postcss.config.mjs",
        "tsconfig.json",
        "public/**"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "mobile:build": {
      "dependsOn": [
        "proto:generate"
      ],
      "cache": true
    },
    "rust:build": {
      "dependsOn": [
        "proto:generate"
      ],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    }
  }
}
