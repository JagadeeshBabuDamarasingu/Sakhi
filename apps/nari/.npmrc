# Destructive operation confirmation
confirm-module-purge=false

# ── Supply chain hardening ────────────────────────────────────────────────────

# Enforce pnpm — prevents bypassing store integrity checks with npm or yarn
only-allow=pnpm

# Re-verify file checksums in the content-addressable store on every install
# Protects against store tampering between installs
verify-store-integrity=true

# Require valid TLS certificates for all registry connections
strict-ssl=true

# Pin exact versions when adding new packages — no ^ or ~ drift in package.json
save-exact=true

# Scan for CVEs on every install
audit=true

# Explicit public registry — blocks accidental leakage to a private registry
registry=https://registry.npmjs.org/
